{======== CHAN2026-FULL 缠论精确分析公式 · 白色主题配色 ========}
{绑定 CHAN2026-FULL.DLL 为第3号外部DLL}
{精确三类买卖点: T1/T1P/T2/T2S/T3A/T3B}

{-- 绘图开关 (0=关, 1=开) · 可在参数区设为GUI参数 --}
P1:=0; {笔}
P2:=1; {线段}
P3:=1; {线段的线段}
P4:=0; {笔级中枢}
P5:=1; {线段级中枢}
P6:=0; {笔级买卖点(全部)}
P7:=0; {线段级买卖点(全部)}
P8:=1; {线段级S2买卖点}
P9:=1; {线段级S3B买卖点}

{-- 核心计算 --}
DLL:=TDXDLL3(1,H,L,C);
HIB:=TDXDLL3(2,DLL,H,L);
LOB:=TDXDLL3(3,DLL,H,L);
SIG:=TDXDLL3(4,DLL,H,L);
BSP:=TDXDLL3(5,DLL,H,L);
SEG:=TDXDLL3(9,DLL,H,L);

{-- 线段级中枢数据 --}
SZSH:=TDXDLL3(15,DLL,H,L);
SZSL:=TDXDLL3(16,DLL,H,L);
SZSS:=TDXDLL3(17,DLL,H,L);

{-- 笔级中枢 · 琥珀橙 #C07828 --}
IF(P4 AND HIB,HIB,DRAWNULL), COLORC07828;
IF(P4 AND LOB,LOB,DRAWNULL), COLORC07828;
STICKLINE(P4 AND SIG,LOB,HIB,0,0), COLORC07828;

{-- 线段级中枢 · 深紫 #6A0DAD --}
IF(P5 AND SZSH,SZSH,DRAWNULL), COLOR6A0DAD;
IF(P5 AND SZSL,SZSL,DRAWNULL), COLOR6A0DAD;
STICKLINE(P5 AND SZSS,SZSL,SZSH,0,0), COLOR6A0DAD;

{-- 笔连线 · 钢青蓝 #2C6FAC --}
DRAWLINE(P1 AND DLL=-1,L,DLL=+1,H,0), COLOR2C6FAC;
DRAWLINE(P1 AND DLL=+1,H,DLL=-1,L,0), COLOR2C6FAC;

{-- 线段连线 · 暗金 #B8860B，加粗 --}
DRAWLINE(P2 AND SEG<-1.5,L,SEG>1.5,H,0), COLORB8860B, LINETHICK2;
DRAWLINE(P2 AND SEG>1.5,H,SEG<-1.5,L,0), COLORB8860B, LINETHICK2;

{-- 线段的线段连线 · 深红 #8B0000，加粗 --}
SEGSEG:=TDXDLL3(13,DLL,H,L);
DRAWLINE(P3 AND SEGSEG<-2.5,L,SEGSEG>2.5,H,0), COLOR8B0000, LINETHICK3;
DRAWLINE(P3 AND SEGSEG>2.5,H,SEGSEG<-2.5,L,0), COLOR8B0000, LINETHICK3;

{-- 一类买卖点 (趋势背驰) · 系统红绿箭头 --}
BUY(P6 AND BSP>0.9 AND BSP<1.1,L);
SELL(P6 AND BSP>10.9 AND BSP<11.1,H);

{-- 一类P买卖点 (盘整背驰) · 标注文字 --}
DRAWTEXT(P6 AND BSP>1.4 AND BSP<1.6,L*0.99,'1P'),COLORFF4444;
DRAWTEXT(P6 AND BSP>11.4 AND BSP<11.6,H*1.01,'1P'),COLOR44BB44;

{-- 二类买卖点 --}
BUYSHORT(P6 AND BSP>1.9 AND BSP<2.1,L);
SELLSHORT(P6 AND BSP>11.9 AND BSP<12.1,H);

{-- 类二买卖点 (T2S) --}
DRAWTEXT(P6 AND BSP>2.4 AND BSP<2.6,L*0.99,'2S'),COLORFF4444;
DRAWTEXT(P6 AND BSP>12.4 AND BSP<12.6,H*1.01,'2S'),COLOR44BB44;

{-- 三类a买卖点 --}
DRAWTEXT(P6 AND BSP>2.9 AND BSP<3.1,L*0.99,'3A'),COLORFF6600;
DRAWTEXT(P6 AND BSP>12.9 AND BSP<13.1,H*1.01,'3A'),COLOR0066FF;

{-- 三类b买卖点 --}
DRAWTEXT(P6 AND BSP>3.4 AND BSP<3.6,L*0.99,'3B'),COLORFF6600;
DRAWTEXT(P6 AND BSP>13.4 AND BSP<13.6,H*1.01,'3B'),COLOR0066FF;

{-- 线段级一类买卖点 · 紫/深绿 --}
DRAWTEXT(P7 AND BSP>20.9 AND BSP<21.1,L*0.98,'S1'),COLOR9933FF;
DRAWTEXT(P7 AND BSP>30.9 AND BSP<31.1,H*1.02,'S1'),COLOR33CC99;

{-- 线段级盘整背驰买卖点 --}
DRAWTEXT(P7 AND BSP>21.4 AND BSP<21.6,L*0.98,'SP'),COLOR9933FF;
DRAWTEXT(P7 AND BSP>31.4 AND BSP<31.6,H*1.02,'SP'),COLOR33CC99;

{-- 线段级二类买卖点 --}
DRAWTEXT((P7 OR P8) AND BSP>21.9 AND BSP<22.1,L*0.98,'S2'),COLOR9933FF;
DRAWTEXT((P7 OR P8) AND BSP>31.9 AND BSP<32.1,H*1.02,'S2'),COLOR33CC99;

{-- 线段级类二买卖点 --}
DRAWTEXT(P7 AND BSP>22.4 AND BSP<22.6,L*0.98,'S2S'),COLOR9933FF;
DRAWTEXT(P7 AND BSP>32.4 AND BSP<32.6,H*1.02,'S2S'),COLOR33CC99;

{-- 线段级三类a买卖点 --}
DRAWTEXT(P7 AND BSP>22.9 AND BSP<23.1,L*0.98,'S3A'),COLORCC6600;
DRAWTEXT(P7 AND BSP>32.9 AND BSP<33.1,H*1.02,'S3A'),COLOR0066CC;

{-- 线段级三类b买卖点 --}
DRAWTEXT((P7 OR P9) AND BSP>23.4 AND BSP<23.6,L*0.98,'S3B'),COLORCC6600;
DRAWTEXT((P7 OR P9) AND BSP>33.4 AND BSP<33.6,H*1.02,'S3B'),COLOR0066CC;
