{======== CHAN2026-FULL 缠论精确分析公式 · 白色主题配色 ========}
{绑定 CHAN2026-FULL.DLL 为第3号外部DLL}
{精确三类买卖点: T1/T1P/T2/T2S/T3A/T3B}

{-- 核心计算 --}
DLL:=TDXDLL3(1,H,L,C);
HIB:=TDXDLL3(2,DLL,H,L);
LOB:=TDXDLL3(3,DLL,H,L);
SIG:=TDXDLL3(4,DLL,H,L);
BSP:=TDXDLL3(5,DLL,H,L);
SEG:=TDXDLL3(9,DLL,H,L);

{-- 中枢区间绘制 · 琥珀橙 #C07828 --}
IF(HIB,HIB,DRAWNULL), COLORC07828;
IF(LOB,LOB,DRAWNULL), COLORC07828;
STICKLINE(SIG,LOB,HIB,0,0), COLORC07828;

{-- 笔连线 · 钢青蓝 #2C6FAC --}
DRAWLINE(DLL=-1,L,DLL=+1,H,0), COLOR2C6FAC;
DRAWLINE(DLL=+1,H,DLL=-1,L,0), COLOR2C6FAC;

{-- 线段连线 · 暗金 #B8860B，加粗 --}
DRAWLINE(SEG<-1.5,L,SEG>1.5,H,0), COLORB8860B, LINETHICK2;
DRAWLINE(SEG>1.5,H,SEG<-1.5,L,0), COLORB8860B, LINETHICK2;

{-- 一类买卖点 (趋势背驰) · 系统红绿箭头 --}
BUY(BSP>0.9 AND BSP<1.1,L);
SELL(BSP>10.9 AND BSP<11.1,H);

{-- 一类P买卖点 (盘整背驰) · 标注文字 --}
DRAWTEXT(BSP>1.4 AND BSP<1.6,L*0.99,'1P'),COLORFF4444;
DRAWTEXT(BSP>11.4 AND BSP<11.6,H*1.01,'1P'),COLOR44BB44;

{-- 二类买卖点 --}
BUYSHORT(BSP>1.9 AND BSP<2.1,L);
SELLSHORT(BSP>11.9 AND BSP<12.1,H);

{-- 类二买卖点 (T2S) --}
DRAWTEXT(BSP>2.4 AND BSP<2.6,L*0.99,'2S'),COLORFF4444;
DRAWTEXT(BSP>12.4 AND BSP<12.6,H*1.01,'2S'),COLOR44BB44;

{-- 三类a买卖点 --}
DRAWTEXT(BSP>2.9 AND BSP<3.1,L*0.99,'3A'),COLORFF6600;
DRAWTEXT(BSP>12.9 AND BSP<13.1,H*1.01,'3A'),COLOR0066FF;

{-- 三类b买卖点 --}
DRAWTEXT(BSP>3.4 AND BSP<3.6,L*0.99,'3B'),COLORFF6600;
DRAWTEXT(BSP>13.4 AND BSP<13.6,H*1.01,'3B'),COLOR0066FF;
